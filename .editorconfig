root = true

[*]
indent_style = tab
indent_size = 2
tab_width = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# YAML forbids tab characters for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown uses leading spaces for nested lists and continuations.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
